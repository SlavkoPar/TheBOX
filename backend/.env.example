FLASK_APP=wsgi.py
FLASK_DEBUG=1
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/thebox
CORS_ORIGINS=http://localhost:5173

# Base URL of the frontend, used to build the link in the confirmation email
FRONTEND_URL=http://localhost:5173
# Lifetime of the confirmation link, in seconds (default 24 hours)
CONFIRM_TOKEN_MAX_AGE=86400
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0

# Largest upload in megabytes (Drive and Photos)
MAX_UPLOAD_MB=25
# Storage per user in megabytes, across Drive and Photos (trash included); 0 = no limit
STORAGE_QUOTA_MB=500
# Days a shared link stays valid; 0 = never expires
SHARE_MAX_AGE_DAYS=30
# Seconds between checks for calendar reminders to email; 0 = off
REMINDER_INTERVAL_SECONDS=60

# SMTP. Leave SMTP_HOST empty to log emails to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
# SMTP_USER is accepted as another name for SMTP_USERNAME
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS (port 587)
SMTP_USE_TLS=1
# Implicit TLS (port 465); overrides SMTP_USE_TLS
SMTP_USE_SSL=0
# SMTP_FROM is accepted as another name for MAIL_FROM
MAIL_FROM=TheBOX <no-reply@example.com>
